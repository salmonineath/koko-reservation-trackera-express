// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs" // this project is CommonJS ("type": "commonjs" in package.json)
}

datasource db {
  provider = "postgresql"
}

// Matches doc section 5.1 and the Add Reservation / Reservations design screens.
enum ReservationSource {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  TELEGRAM
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Reservation {
  id           Int               @id @default(autoincrement())
  customerName String
  phone        String
  // Date + time combined into one instant (form shows them as two inputs,
  // but storing one DateTime avoids timezone/sort bugs vs. two raw columns).
  date         DateTime
  guests       Int
  source       ReservationSource
  status       ReservationStatus @default(PENDING)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([date])
  @@index([status])
  @@index([source])
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  fullName     String?
  username     String?   @unique
  role         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshToken RefreshToken?
}

// Rotation model: exactly one row per user. Only the token's SHA-256 hash is
// stored (never the raw token) so a DB leak alone doesn't hand out usable
// tokens. Every /auth/refresh call deletes this row and creates its
// replacement in the same transaction, so the row is always the single
// currently-valid refresh token - never a growing history. userId is unique
// so the DB itself enforces the one-row-per-user invariant.
model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id])
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
